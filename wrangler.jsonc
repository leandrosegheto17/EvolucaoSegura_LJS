{
  // Worker único: assets do front (T24) e API Hono em /api/*.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "evolucao-segura",
  "main": "backend/api/src/index.ts",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    // O build do web (pnpm --filter @es/web build) gera este diretório.
    "directory": "./frontend/web/dist",
    // Rota desconhecida do front devolve o index.html (SPA).
    "not_found_handling": "single-page-application",
    // Só /api/* passa pelo Worker (Hono); o resto vai direto para os arquivos do front.
    "run_worker_first": ["/api/*"],
  },
  // OPS-07 (ADR-006): limite por IP, um namespace (contador) por grupo de rota. O período do
  // binding só pode ser 10 ou 60 s; o limite efetivo medido no Free foi ±1 (spike rate-limit-free).
  "ratelimits": [
    { "name": "LIMITE_ACESSO", "namespace_id": "1001", "simple": { "limit": 10, "period": 60 } },
    { "name": "LIMITE_PUBLICO", "namespace_id": "1002", "simple": { "limit": 60, "period": 60 } },
    { "name": "LIMITE_WEBHOOK", "namespace_id": "1003", "simple": { "limit": 120, "period": 60 } },
  ],
  // PUSH-07 (ADR-010): um único Cron Trigger (a conta tem 5, divididos entre 3 apps); o
  // despachante (backend/api/src/tarefas/despachar.ts) chama as tarefas em ordem.
  "triggers": { "crons": ["*/5 * * * *"] },
  "hyperdrive": [
    {
      "binding": "HYPERDRIVE",
      // PLACEHOLDER: o id real vem do `wrangler hyperdrive create` (T34), na decisão do primeiro deploy.
      "id": "00000000000000000000000000000000",
      // Postgres local do docker-compose (porta 5433 no host). Em CI, a variável
      // CLOUDFLARE_HYPERDRIVE_LOCAL_CONNECTION_STRING_HYPERDRIVE substitui este valor.
      "localConnectionString": "postgres://postgres:postgres@localhost:5433/evolucao_segura",
    },
  ],
}
