{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "model": "sonnet",
  "permissions": {
    "allow": [
      "Read",
      "Grep",
      "Glob",
      "Bash(git status:*)",
      "Bash(git log:*)",
      "Bash(git diff:*)",
      "Bash(git show:*)",
      "Bash(git branch:*)",
      "Bash(git ls-remote:*)",
      "Bash(ls:*)",
      "Bash(python .claude/scripts/verificar-atualizacoes.py:*)",
      "Bash(python .claude/scripts/checar-tokens.py:*)",
      "Bash(python .claude/scripts/trava-testes.py:*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python \"$CLAUDE_PROJECT_DIR/.claude/scripts/trava-testes.py\"",
            "timeout": 600
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "startup",
        "hooks": [
          {
            "type": "command",
            "command": "python \"$CLAUDE_PROJECT_DIR/.claude/scripts/verificar-atualizacoes.py\" --silencioso",
            "timeout": 30
          }
        ]
      }
    ]
  }
}
