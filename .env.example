# Variáveis do Evolução Segura (OPS-11).
# Formato de cada linha de documentação:
#   NOME | obrigatória ou opcional | formato | segredo ou não é segredo
# Local: copie as do Worker para .dev.vars na raiz, ao lado do wrangler.jsonc (fora do git). Produção: `wrangler secret`
# para os segredos e `--var` para URL_PUBLICA. Os valores abaixo são só modelos.
# Variáveis marcadas como segredo ficam SEM valor neste arquivo.

# ---------- Worker (validadas por backend/api/src/ambiente.ts) ----------

# URL_PUBLICA | obrigatória | URL https (http só em localhost), sem barra final | não é segredo
URL_PUBLICA=http://localhost:8787

# MAIL_FROM | opcional (obrigatória a partir da T42) | e-mail ou "Nome <e-mail>" de evolucaosegura.com.br | não é segredo
MAIL_FROM=Evolução Segura <nao-responda@evolucaosegura.com.br>

# RESEND_API_KEY | opcional (obrigatória a partir da T42) | começa com re_ | segredo
RESEND_API_KEY=

# HMAC_2FA_SEGREDO | obrigatória | texto com 32 caracteres ou mais | segredo
HMAC_2FA_SEGREDO=

# E2E_EMAIL_CAPTURA_URL | opcional (só no e2e local; nunca em produção) | URL http em localhost ou 127.0.0.1 | não é segredo
E2E_EMAIL_CAPTURA_URL=

# ASAAS_API_KEY | opcional (obrigatória a partir da etapa 12) | texto fornecido pelo Asaas | segredo
ASAAS_API_KEY=

# ASAAS_WEBHOOK_TOKEN | opcional (obrigatória a partir da etapa 12) | texto com 32 caracteres ou mais | segredo
ASAAS_WEBHOOK_TOKEN=

# ASAAS_BASE_URL | opcional (obrigatória a partir da etapa 12) | https://api-sandbox.asaas.com/v3 ou https://api.asaas.com/v3 | não é segredo
ASAAS_BASE_URL=https://api-sandbox.asaas.com/v3

# VAPID_PUBLIC_KEY | opcional (obrigatória a partir da etapa 13) | base64url | não é segredo
VAPID_PUBLIC_KEY=

# VAPID_PRIVATE_KEY | opcional (obrigatória a partir da etapa 13) | base64url | segredo
VAPID_PRIVATE_KEY=

# VAPID_SUBJECT | opcional (obrigatória a partir da etapa 13) | mailto:e-mail ou URL https | não é segredo
VAPID_SUBJECT=mailto:contato@evolucaosegura.com.br

# SENTRY_DSN | opcional (sem ele o Sentry fica desligado) | URL https do projeto no Sentry | não é segredo
SENTRY_DSN=

# SENTRY_RELEASE | opcional | SHA do commit (7 a 40 caracteres hexadecimais) | não é segredo
SENTRY_RELEASE=

# ---------- Build do front (variáveis VITE_ entram no bundle: nunca coloque segredo aqui) ----------

# VITE_SENTRY_DSN | opcional (sem ele o Sentry do app fica desligado) | URL https do projeto no Sentry | não é segredo
VITE_SENTRY_DSN=

# VITE_SENTRY_RELEASE | opcional | SHA do commit (7 a 40 caracteres hexadecimais); o deploy.yml define | não é segredo
VITE_SENTRY_RELEASE=

# ---------- Testes e scripts locais ----------

# DATABASE_URL | opcional (padrão: Postgres do docker-compose na porta 5433) | URL postgres:// de host local (nunca o Neon: o pnpm migrar recusa host remoto) | segredo
DATABASE_URL=

# NEON_URL_MIGRACAO_DEV | opcional (só no terminal, para pnpm migrar --alvo dev) | URL postgres:// direta (sem -pooler) do Neon, banco evolucao, branch dev, role de migração, sslmode=require | segredo
NEON_URL_MIGRACAO_DEV=

# ---------- Pipeline (GitHub Secrets do environment producao; não são do Worker) ----------

# NEON_URL_MIGRACAO | obrigatória no deploy.yml (pnpm migrar --alvo producao) | URL postgres:// direta (sem -pooler) do Neon, banco evolucao, branch main, role de migração, sslmode=require | segredo
NEON_URL_MIGRACAO=

# NEON_URL_BACKUP | obrigatória no backup.yml | URL postgres:// direta (sem -pooler) do Neon, banco evolucao, branch main, role backup_ro, sslmode=require | segredo
NEON_URL_BACKUP=

# AGE_PUBLIC_KEY | obrigatória no deploy.yml e no backup.yml | chave pública age (começa com age1) | não é segredo
AGE_PUBLIC_KEY=

# NEON_URL_APP | obrigatória só ao criar o Hyperdrive (backend/scripts/src/hyperdrive.ts) | URL postgres:// direta (sem -pooler) do Neon, banco evolucao, branch main, role app, sslmode=require | segredo
NEON_URL_APP=

# CLOUDFLARE_API_TOKEN | obrigatória no deploy.yml | token da Cloudflare com permissão de deploy do Worker | segredo
CLOUDFLARE_API_TOKEN=

# CLOUDFLARE_ACCOUNT_ID | obrigatória no deploy.yml | identificador da conta Cloudflare | não é segredo
CLOUDFLARE_ACCOUNT_ID=
